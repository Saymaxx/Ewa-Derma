# Database Configuration
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/ewa_derma_db?schema=public"

# Application Configuration
PORT=4000
NODE_ENV=development
APP_NAME="Ewa Derma Clinic Management System"
FRONTEND_URL="http://localhost:3000"

# JWT Authentication
JWT_ACCESS_SECRET="ewa_derma_super_secret_access_jwt_key_2026_clinical"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="ewa_derma_super_secret_refresh_jwt_key_2026_clinical"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@ewaderma.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Ewa Derma Clinic <notifications@ewaderma.com>"

# Meta WhatsApp Cloud API Configuration
# Get these from Meta Business Suite -> WhatsApp -> API Setup
# Permanent System User Access Token recommended for production
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_META_PERMANENT_OR_TEST_ACCESS_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WHATSAPP_API_VERSION="v21.0"
